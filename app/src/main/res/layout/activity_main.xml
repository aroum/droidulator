<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gruvbox_bg"
    android:padding="8dp">

    <!-- Top Status Header Bar & Mode Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/gruvbox_bg_soft"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/toolbar_gap"
        android:paddingVertical="@dimen/toolbar_padding_vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
        <!-- Top Dropdown Spinner Mode Switcher -->
        <Spinner
            android:id="@+id/spinner_tabs"
            android:contentDescription="@string/access_spinner_tabs"
            android:layout_width="86dp"
            android:layout_height="@dimen/toolbar_control_size"
            android:background="@null"
            android:spinnerMode="dropdown"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <EditText
            android:id="@+id/search_query"
            android:layout_width="86dp"
            android:layout_height="@dimen/toolbar_control_size"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:hint="@string/search"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingHorizontal="4dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_toggle"
            android:layout_marginStart="@dimen/toolbar_gap"
            android:layout_width="@dimen/toolbar_control_size"
            android:layout_height="@dimen/toolbar_control_size"
            android:padding="0dp"
            android:contentDescription="@string/search"
            android:visibility="gone"
            app:icon="@drawable/ic_search"
            app:iconSize="@dimen/toolbar_icon_size"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <!-- Add Item Button (+) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_item"
            android:contentDescription="@string/access_btn_add_item"
            android:layout_width="@dimen/toolbar_control_size"
            android:layout_height="@dimen/toolbar_control_size"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_yellow"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/toolbar_gap" app:icon="@drawable/ic_add" app:iconSize="@dimen/toolbar_icon_size" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/gruvbox_bg" />

        <!-- Delete All Items Button (Red ✕) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_all"
            android:contentDescription="@string/access_btn_delete_all"
            android:layout_width="@dimen/toolbar_control_size"
            android:layout_height="@dimen/toolbar_control_size"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_red"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/toolbar_gap" app:icon="@drawable/ic_close" app:iconSize="@dimen/toolbar_icon_size" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/gruvbox_bg" />

        <!-- Toggle e-history variables (#) -->
        <Button
            android:id="@+id/btn_toggle_evars"
            android:contentDescription="@string/access_btn_toggle_evars"
            android:layout_width="@dimen/toolbar_control_size"
            android:layout_height="@dimen/toolbar_control_size"
            android:text="@string/ui_text_024"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_aqua"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <!-- Spacer View to push formatting options to the right -->


        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <!-- Format Mode Spinner (NORM, FLT, FIX, SCI, ENG) -->
        <Spinner
            android:id="@+id/spinner_fmt_mode"
            android:contentDescription="@string/access_spinner_fmt_mode"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_control_size"
            android:background="@null"
            android:spinnerMode="dropdown"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <!-- Precision Spinner (0dp .. 12dp) -->
        <Spinner
            android:id="@+id/spinner_fmt_prec"
            android:contentDescription="@string/access_spinner_fmt_prec"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_control_size"
            android:background="@null"
            android:spinnerMode="dropdown"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <TextView
            android:id="@+id/tv_mode"
            android:layout_marginStart="@dimen/toolbar_gap"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_control_size"
            android:text="@string/ui_text_025"
            android:textColor="@color/gruvbox_yellow"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
        </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Output / Terminal Log Area -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gruvbox_bg"
        android:padding="4dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/gruvbox_fg"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>

    <!-- Dedicated Plot View Container -->
    <com.cardputer.cardulator.PlotView
        android:id="@+id/plot_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gruvbox_bg"
        android:visibility="gone" />

    <!-- Settings Menu UI Container -->
    <ScrollView
        android:id="@+id/scroll_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gruvbox_bg"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <TextView
                android:id="@+id/tv_settings_section_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_027"
                android:textColor="@color/gruvbox_fg"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rg_theme_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rb_theme_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_text_028"
                    android:textColor="@color/gruvbox_fg"
                    android:buttonTint="@color/gruvbox_aqua"
                    android:fontFamily="monospace" />

                <RadioButton
                    android:id="@+id/rb_theme_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_text_029"
                    android:textColor="@color/gruvbox_fg"
                    android:buttonTint="@color/gruvbox_aqua"
                    android:fontFamily="monospace" />

                <RadioButton
                    android:id="@+id/rb_theme_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_text_030"
                    android:textColor="@color/gruvbox_fg"
                    android:buttonTint="@color/gruvbox_aqua"
                    android:fontFamily="monospace" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_settings_section_custom_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_031"
                android:textColor="@color/gruvbox_fg"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_load_custom_theme"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/ui_text_032"
                    android:textColor="@color/gruvbox_bg"
                    android:backgroundTint="@color/gruvbox_aqua"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_reset_custom_theme"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/ui_text_033"
                    android:textColor="@color/gruvbox_fg"
                    android:backgroundTint="@color/gruvbox_bg_soft"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_settings_section_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_034"
                android:textColor="@color/gruvbox_fg"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_hide_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_035"
                android:textColor="@color/gruvbox_fg"
                android:buttonTint="@color/gruvbox_aqua"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_auto_pair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_036"
                android:textColor="@color/gruvbox_fg"
                android:buttonTint="@color/gruvbox_aqua"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_digit_grouping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_037"
                android:textColor="@color/gruvbox_fg"
                android:buttonTint="@color/gruvbox_aqua"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_settings_section_enter_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_038"
                android:textColor="@color/gruvbox_fg"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/btn_settings_enter_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_send_checkbox"
                android:textColor="@color/gruvbox_fg"
                android:buttonTint="@color/gruvbox_aqua"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_settings_clear_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_text_040"
                android:textColor="@color/gruvbox_bg"
                android:backgroundTint="@color/gruvbox_red"
                android:fontFamily="monospace"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Dedicated List Menu Container (Variables, Formulas, Constants, Scripts) -->
    <ScrollView
        android:id="@+id/scroll_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gruvbox_bg"
        android:paddingTop="3dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Input Box & Error Overlay Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_input"
            android:textColorHint="@color/gruvbox_fg_dim"
            android:textColor="@color/gruvbox_fg"
            android:background="@color/gruvbox_bg_soft"
            android:fontFamily="monospace"
            android:textSize="15sp"
            android:padding="10dp"
            android:minLines="1"
            android:maxLines="6"
            android:scrollbars="vertical"
            android:imeOptions="actionDone"
            android:inputType="textMultiLine|textNoSuggestions" />

        <TextView
            android:id="@+id/tv_error_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6FB4934"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <!-- Sticky Keyboard Toolbar (Navigation & Controls Bar) -->
    <LinearLayout
        android:id="@+id/toolbar_keyboard"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/gruvbox_bg_soft"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/toolbar_gap"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Navigation Arrow Buttons -->
        <Button
            android:id="@+id/btn_nav_left"
            android:contentDescription="@string/access_btn_nav_left"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="@string/ui_text_041"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_blue"
            android:textSize="12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/btn_nav_right"
            android:contentDescription="@string/access_btn_nav_right"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="@string/ui_text_042"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_blue"
            android:textSize="12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <Button
            android:id="@+id/btn_nav_up"
            android:contentDescription="@string/access_btn_nav_up"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="@string/ui_text_043"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_purple"
            android:textSize="12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <Button
            android:id="@+id/btn_nav_down"
            android:contentDescription="@string/access_btn_nav_down"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="@string/ui_text_044"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_purple"
            android:textSize="12sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tab Autocomplete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab"
            android:contentDescription="@string/btn_tab"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:backgroundTint="@color/gruvbox_yellow"
            app:icon="@drawable/ic_tab"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/toolbar_icon_size"
            app:iconTint="@color/gruvbox_bg"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <!-- Clear Input / History Button -->
        <Button
            android:id="@+id/btn_clear"
            android:contentDescription="@string/access_btn_clear"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="@string/btn_clear"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_red"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="@dimen/toolbar_gap" />

        <!-- Enter / Send Command Button (2u width, visible when Enter-to-send is disabled) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enter"
            android:contentDescription="@string/access_btn_enter"
            android:layout_width="@dimen/toolbar_control_size"
            android:layout_height="match_parent"
            app:icon="@drawable/ic_enter" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="@dimen/toolbar_icon_size"
            android:textColor="@color/gruvbox_bg"
            android:backgroundTint="@color/gruvbox_green"
            android:fontFamily="sans-serif"
            android:textSize="26sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="@dimen/toolbar_gap"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
